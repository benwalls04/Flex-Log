# Copy this file to .env and fill in your values.
# All Vite env vars must be prefixed with VITE_ to be exposed to the client.

# Tracking + Recommendation API (same gateway base URL, no trailing slash)
# e.g. https://your-api-id.execute-api.region.amazonaws.com/prod
VITE_API_BASE_URL=

# Supabase (auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
